# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Privileged server access. Never expose to the browser.
DATABASE_URL=

# eSewa ePay v2
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_ENV=uat

# Cron authentication (Vercel Cron -> /api/cron/*)
CRON_SECRET=

# Admin console. One shared password for the whole team — there is no user
# management by design. Also the HMAC key for the admin session cookie, so
# rotating it signs everyone out.
ADMIN_PASSWORD=change-me-before-deploying

# Canonical site URL. Swap for a custom domain later without a code change.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
