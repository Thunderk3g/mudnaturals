# dependencies
node_modules/
/.pnp
.pnp.*

# secrets — never commit
.env
.env.*
!.env.example
environments/

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
.vercel
*.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

