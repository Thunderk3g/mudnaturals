/tmp/

# installed agent skills (reproducible from skills-lock.json)
.agents/
.vercel
.env*

# local build escape hatch (see NEXT_DIST_DIR in next.config.ts). A glob, not a
# list: every named directory anyone picks is build output, and one that slipped
# through turned a bare `npm run lint` into 8,600 problems from compiled files.
.next-*/
